{
  "name": "vizualizator",
  "productName": "Vizualizator v1.0",
  "version": "1.0.0",
  "description": "Musiqa vizualizatori / Музыкальный визуализатор",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "dist": "node scripts/check-features.mjs && vite build && electron-builder --win --x64",
    "artifact": "node scripts/check-features.mjs && vite build && node scripts/build-artifact.mjs",
    "check": "node scripts/check-features.mjs"
  },
  "dependencies": {
    "mp4-muxer": "5.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.7"
  },
  "build": {
    "appId": "uz.vizualizator.app",
    "productName": "Vizualizator v1.0",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1091"
    }
  }
}
